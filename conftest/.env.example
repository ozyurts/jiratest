# Confluence bağlantı bilgileri
CONFLUENCE_BASE_URL=https://confluence.sirketiniz.com
CONFLUENCE_API_TOKEN=buraya-pat-token

# PAT (Personal Access Token) kullanıyorsan CONFLUENCE_USERNAME'i boş bırak
# Kullanıcı adı + şifre ile Basic Auth kullanıyorsan yaz
CONFLUENCE_USERNAME=

CONFLUENCE_SPACE_KEY=          # Opsiyonel: belirli bir space'i ara (örn: HR, MGMT)

# Anthropic API anahtarı
ANTHROPIC_API_KEY=sk-ant-...
