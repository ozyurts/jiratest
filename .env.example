# ─────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────
# Dev: SQLite (relative path)
DATABASE_URL="file:./dev.db"

# Prod: PostgreSQL (set via environment variables / secrets manager — NEVER hardcode)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/workload_tracker?schema=public"

# ─────────────────────────────────────────────────────────
# AUTH / JWT
# ─────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET="REPLACE_WITH_STRONG_SECRET_MINIMUM_32_CHARS"

# Access token expiry (must be <= 1h per NFR §4.1)
JWT_ACCESS_EXPIRES_IN="3600"   # seconds → 1 hour

# Refresh token expiry (must be <= 24h per NFR §4.1)
JWT_REFRESH_EXPIRES_IN="86400" # seconds → 24 hours

# ─────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# NODE_ENV is set automatically by Next.js (development | production | test)
